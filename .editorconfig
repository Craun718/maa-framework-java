root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.bat]
end_of_line = crlf

[*.java]
continuation_indent_size = 8
ij_java_align_multiline_parameters = false
ij_java_binary_operation_sign_on_next_line = true
ij_java_binary_operation_wrap = 1
ij_java_call_parameters_wrap = 1
ij_java_continuation_indent_size = 8
ij_java_indent_size = 4
ij_java_keep_blank_lines_in_code = 1
ij_java_keep_blank_lines_in_declarations = 1
ij_java_keep_blank_lines_before_rbrace = 1
ij_java_method_parameters_wrap = 1
ij_java_right_margin = 140
ij_java_tab_size = 4
ij_java_ternary_operation_wrap = 1
ij_java_use_tab_character = false

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.{kts,gradle}]
indent_style = space
indent_size = 4

[*.{xml,xhtml}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2
